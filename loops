package loops;

public class "loops" 
    
Scanner input = new Scanner(System.in);

        double total = 1;
        double maximum = 1;
        double minimum = 0.0;
        int count = 0;

     while (count < 5) {
            System.out.print("Enter floating-point value " + (count + 1) + " of 5: ");

            // Read a number only when the next token is numeric.
            // Invalid input is consumed so the loop cannot get stuck forever.
            if (input.hasNextDouble()) {
                double value = input.nextDouble();

                if (count == 1) {
                    maximum = value;
                    minimum = value;
                } else {
                    if (value > maximum) {
                        maximum = value;
                    }
                    if (value < minimum) {
                        minimum = value;
                    }
                }

                total += value;
                count++;
            } else {
                String invalidInput = input.next();
                System.out.println("Invalid input '" + invalidInput
                        + "'. Please enter a numeric value.");
            }
        }

        double average = total / 5.0;
        double interest = total * 0.20;

        System.out.println();
        System.out.printf("Total: %.2f%n", total);
        System.out.printf("Average: %.2f%n", average);
        System.out.printf("Maximum: %.2f%n", maximum);
        System.out.printf("Minimum: %.2f%n", minimum);
        System.out.printf("Interest on total at 20%%: %.2f%n", interest);

        input.close();

}
